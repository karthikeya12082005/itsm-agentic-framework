# ITSM Agentic Framework - environment template.
# Copy to .env (same folder) and fill in the values. NEVER commit .env, never paste its values in chat/screenshots.
# Values are single-quoted. Leave optional values empty if you do not use them.
# How to get each value: see "API KEY / ACCOUNT GUIDE" in CLAUDE.md.

# ---------------------------------------------------------------- Knowledge store (Neon PostgreSQL + pgvector)
# console.neon.tech -> project -> Connect -> connection string (psycopg, sslmode=require)
DATABASE_URL=''

# ---------------------------------------------------------------- Endpoint enforcement service (Objective 2)
ENDPOINT_URL='http://127.0.0.1:8765'
# Random secret, at least 24 characters (generate locally, see CLAUDE.md)
ENDPOINT_TOKEN=''

# ---------------------------------------------------------------- ServiceNow PDI (system of record, REQUIRED)
SERVICENOW_INSTANCE='https://dev219979.service-now.com'
SERVICENOW_USER='ai.agent'
# 24-character alphanumeric password set for ai.agent in the PDI
SERVICENOW_PASSWORD=''
# Optional: only while running setup scripts; remove afterwards (setup scripts also ask with getpass)
SERVICENOW_ADMIN_PASSWORD=''

# ---------------------------------------------------------------- LLM providers (all optional: rule-based fallback always works)
# Google Gemini - aistudio.google.com -> Get API key
GEMINI_API_KEY=''
GEMINI_MODEL_LITE='gemini-3.5-flash-lite'
# Groq (open models: gpt-oss, Qwen; no Llama chat models as of Nov 2026) - console.groq.com -> API Keys
GROQ_API_KEY=''
# Local Ollama - ollama.com Windows installer, then: ollama pull <small model>
OLLAMA_BASE_URL='http://localhost:11434'
# Hugging Face read token (removes the "unauthenticated requests" warning)
HF_TOKEN=''

# ---------------------------------------------------------------- Model per agent, format provider:model
# provider = gemini | groq | ollama   (verify model IDs with: python -m src.common.check_llms)
LLM_UNDERSTANDING=''
LLM_RETRIEVAL=''
LLM_RCA=''
LLM_CRITIC=''
LLM_COMMUNICATION=''

# ---------------------------------------------------------------- Notifications (Phase 6.5, optional)
# One real mailbox for ALL demo people: user records get plus-addresses, e.g. name+employee01@gmail.com
NOTIFY_DEMO_EMAIL=''
# SMTP fallback used by the agents when ServiceNow email is not available (Gmail: smtp.gmail.com, 587,
# SMTP_USER = the Gmail address, SMTP_PASSWORD = a 16-character App Password; needs 2-Step Verification)
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASSWORD=''
